@{
    ViewData["Title"] = "Meeting Concluded";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ayute</title>
    <style>
        :root {
            --primary-green: #39B34A;
            --primary-yellow: #DEE33B;
            --primary-blue: #073150;
            --light-green: #E9F7EC;
            --light-yellow: #FDFDE8;
            --light-blue: #F0F7FB;
            --white: #FFFFFF;
            --gray: #5D6D7E;
            --light-gray: #F5F5F5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, #0c4168 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .success-container {
            width: 100%;
            max-width: 500px;
        }

        .success-card {
            background: var(--white);
            border-radius: 12px;
            padding: 50px 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
            border: 1px solid var(--light-green);
        }

        .success-icon {
            width: 80px;
            height: 80px;
            background-color: var(--light-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            font-size: 40px;
            color: var(--primary-green);
        }

        h1 {
            color: var(--primary-blue);
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        p {
            color: var(--gray);
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .meeting-code {
            background-color: var(--light-blue);
            color: var(--primary-blue);
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 16px;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 30px;
        }

        .next-steps {
            background-color: var(--light-yellow);
            border-left: 4px solid var(--primary-yellow);
            padding: 20px;
            border-radius: 8px;
            text-align: left;
            margin-bottom: 30px;
        }

        .next-steps h3 {
            color: var(--primary-blue);
            font-size: 18px;
            margin-bottom: 10px;
        }

        .next-steps ul {
            padding-left: 20px;
            color: var(--gray);
        }

        .next-steps li {
            margin-bottom: 8px;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-green) 0%, #2e8b3e 100%);
            color: var(--white);
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(57, 179, 74, 0.3);
        }

        .btn-outline {
            background: transparent;
            color: var(--primary-green);
            border: 2px solid var(--primary-green);
        }

        .btn-outline:hover {
            background-color: var(--light-green);
        }

        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 12px;
        }

        @@media (max-width: 480px) {
            .success-card {
                padding: 40px 20px;
            }

            .btn-group {
                flex-direction: column;
            }

            body {
                padding: 10px;
            }
        }
    </style>
</head>

<body>
    <div class="success-container">
        <div class="success-card">
            <div class="success-icon">
                ✓
            </div>

            <h1>Completed!</h1>

            <p>The programme has been concluded ✅.</p>

            <div class="meeting-code">
                Meeting Code: @ViewBag.MeetingCode
            </div>

            @* <div class="next-steps">
                <h3>Next Steps:</h3>
                <ul>
                    <li>Check your email for confirmation (if provided)</li>
                    <li>Add the meeting to your calendar</li>
                    <li>Arrive 10 minutes before the meeting time</li>
                    <li>Bring your QR code if required for check-in</li>
                </ul>
            </div> *@

            <div class="btn-group">
                <a href="/" class="btn btn-primary">Return to Home</a>
                @* <button onclick="window.print()" class="btn btn-outline">Print Confirmation</button> *@
            </div>
        </div>

        <div class="copyright">
            © @DateTime.Now.Year Ayute. All rights reserved.
        </div>
    </div>

    <script>
        // Auto-print option (optional)
        // setTimeout(() => {
        //     if (confirm('Would you like to print your confirmation?')) {
        //         window.print();
        //     }
        // }, 1000);
    </script>
</body>

</html>