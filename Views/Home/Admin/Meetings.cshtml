            const dateText = row.querySelector('td:nth-child(5) div').textContent;
            const attendees = parseInt(row.querySelector('td:nth-child(6) .fw-semibold').textContent);
            totalAttendees += attendees || 0;

            // Simple check - in real app, parse date properly
            const status = row.querySelector('td:nth-child(7) .badge').textContent.toLowerCase();
            if (status.includes('upcoming')) upcoming++;
            if (status.includes('completed')) completed++;
            });

            document.getElementById('upcomingMeetings').textContent = upcoming;
            document.getElementById('completedMeetings').textContent = completed;
            document.getElementById('totalAttendees').textContent = totalAttendees;
