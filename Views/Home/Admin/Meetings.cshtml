            function setupEventListeners() {
            // Meeting type change - use event delegation
            document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'meetingType') {
            const venueLabel = document.querySelector('#venueSection label');
            const venueInput = document.getElementById('meetingVenue');
            const venueHelp = document.querySelector('#venueSection .form-text');

            if (e.target.value === 'virtual' || e.target.value === 'hybrid') {
            venueLabel.textContent = 'Meeting Link *';
            venueInput.placeholder = 'Enter meeting link (Zoom, Teams, Google Meet, etc.)';
            venueHelp.textContent = 'Enter the full meeting URL for virtual participation';
            } else {
            venueLabel.textContent = 'Venue *';
            venueInput.placeholder = 'Enter venue address';
            venueHelp.textContent = 'For physical meetings, enter the complete venue address';
            }
            }
            });

            // Create meeting form submission - use event delegation
            document.addEventListener('submit', function (e) {
            if (e.target && e.target.id === 'createMeetingForm') {
            e.preventDefault();
            createMeeting(e);
            }
            });

            // Filter listeners
            document.getElementById('statusFilter')?.addEventListener('change', filterMeetings);
            document.getElementById('typeFilter')?.addEventListener('change', filterMeetings);
            document.getElementById('searchInput')?.addEventListener('keyup', function (e) {
            if (e.key === 'Enter') filterMeetings();
            });
            document.getElementById('searchBtn')?.addEventListener('click', filterMeetings);

            // Row click for viewing details - use event delegation
            document.addEventListener('click', function (e) {
            const row = e.target.closest('tbody tr[data-meeting-id]');
            if (row && !e.target.closest('.btn-group') && !e.target.closest('button')) {
            const meetingId = row.getAttribute('data-meeting-id');
            viewMeetingAttendees(meetingId);
            }
            });
            }
            function generateMeetingCode() {
            // Generate a random meeting code like "MTG-ABC123"
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = 'MTG-';
            for (let i = 0; i < 6; i++) {
            code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return code;
            }

            function filterMeetings() {
            const status = document.getElementById('statusFilter').value;
            const type = document.getElementById('typeFilter').value;
            const search = document.getElementById('searchInput').value.toLowerCase();

            const rows = document.querySelectorAll('tbody tr[data-meeting-id]');
            let visibleCount = 0;

            rows.forEach(row => {
            const statusCell = row.querySelector('td:nth-child(7) .badge').textContent.toLowerCase();
            const typeCell = row.querySelector('td:nth-child(3) .badge').textContent.toLowerCase();
            const nameCell = row.querySelector('td:nth-child(2) .fw-semibold').textContent.toLowerCase();
            const codeCell = row.querySelector('td:nth-child(2) small').textContent.toLowerCase();

            let shouldShow = true;

            if (status && !statusCell.includes(status)) shouldShow = false;
            if (type && !typeCell.includes(type)) shouldShow = false;
            if (search && !nameCell.includes(search) && !codeCell.includes(search)) shouldShow = false;

            if (shouldShow) {
            row.style.display = '';
            visibleCount++;
            } else {
            row.style.display = 'none';
            }
            });

            document.getElementById('meetingsCount').textContent = visibleCount;

            // Show no results message
            const noResultsRow = document.querySelector('tbody tr:last-child');
            if (visibleCount === 0 && !noResultsRow.getAttribute('data-meeting-id')) {
            noResultsRow.style.display = '';
            } else if (visibleCount > 0 && !noResultsRow.getAttribute('data-meeting-id')) {
            noResultsRow.style.display = 'none';
            }
            }

            function clearFilters() {
            document.getElementById('statusFilter').value = '';
            document.getElementById('typeFilter').value = '';
            document.getElementById('searchInput').value = '';
            filterMeetings();
            }

