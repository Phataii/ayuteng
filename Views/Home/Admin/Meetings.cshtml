@model List<MeetingViewModel>
@{
    ViewData["Title"] = "Meetings Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0" style="color: var(--primary-blue);">
                <i class="bi bi-calendar-check me-2"></i>Meetings/Events Management
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Meetings</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createMeetingModal">
            <i class="bi bi-plus-circle me-2"></i>Create New Meeting
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-icon users">
                        <i class="bi bi-calendar"></i>
                    </div>
                    <div class="stats-value" id="totalMeetings">@Model.Count</div>
                    <div class="stats-label">Total Meetings</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-icon success">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stats-value" id="totalAttendees">0</div>
                    <div class="stats-label">Total Attendees</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-icon warning">
                        <i class="bi bi-clock"></i>
                    </div>
                    <div class="stats-value" id="upcomingMeetings">0</div>
                    <div class="stats-label">Upcoming</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-icon info">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stats-value" id="completedMeetings">0</div>
                    <div class="stats-label">Completed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" style="color: var(--primary-blue);">Status</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">All Meetings</option>
                        <option value="upcoming">Upcoming</option>
                        <option value="ongoing">Ongoing</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" style="color: var(--primary-blue);">Type</label>
                    <select class="form-select" id="typeFilter">
                        <option value="">All Types</option>
                        <option value="physical">Physical</option>
                        <option value="virtual">Virtual</option>
                        <option value="hybrid">Hybrid</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="color: var(--primary-blue);">Search</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchInput" placeholder="Search meetings...">
                        <button class="btn btn-outline-primary" type="button" id="searchBtn">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="color: var(--primary-blue);">&nbsp;</label>
                    <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-2"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Meetings List -->
    <div class="card">
        <div class="card-header" style="background-color: var(--light-green);">
            <h5 class="mb-0" style="color: var(--primary-blue);">
                <i class="bi bi-list-task me-2"></i>Meetings
                <span class="badge bg-primary ms-2" id="meetingsCount">@Model.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Meeting Name</th>
                            <th>Type</th>
                            <th>Venue/Link</th>
                            <th>Date & Time</th>
                            <th>Attendees</th>
                            <th>Status</th>
                            <th style="width: 180px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="meetingsBody">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var meeting = Model[i];
                            <tr data-meeting-id="@meeting.Id">
                                <td>@(i + 1)</td>
                                <td>
                                    <div class="fw-semibold">@meeting.Name</div>
                                    <small class="text-muted">Code: @meeting.MeetingCode</small>
                                </td>
                                <td>
                                    @{
                                        var typeBadgeClass = meeting.Type switch
                                        {
                                            "physical" => "bg-primary",
                                            "virtual" => "bg-info",
                                            "hybrid" => "bg-warning",
                                            _ => "bg-secondary"
                                        };
                                        var typeIcon = meeting.Type switch
                                        {
                                            "physical" => "bi-building",
                                            "virtual" => "bi-camera-video",
                                            "hybrid" => "bi-laptop",
                                            _ => "bi-question-circle"
                                        };
                                    }
                                    <span class="badge @typeBadgeClass">
                                        <i class="bi @typeIcon me-1"></i>@meeting.Type.ToUpper()
                                    </span>
                                </td>
                                <td>
                                    @if (meeting.Type == "virtual" || meeting.Type == "hybrid")
                                    {
                                        <a href="@meeting.Venue" target="_blank" class="text-truncate d-inline-block"
                                               style="max-width: 200px;">
                                            <i class="bi bi-link-45deg me-1"></i>Join Meeting
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;">
                                            <i class="bi bi-geo-alt me-1"></i>@meeting.Venue
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div>@meeting.StartTime.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@meeting.StartTime.ToString("hh:mm tt") -
                                        @meeting.EndTime.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <span class="fw-semibold">@meeting.AttendeeCount</span>
                                                <small class="text-muted">/ @meeting.MaxAttendees</small>
                                            </div>
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                @{
                                                    var percentage = meeting.MaxAttendees > 0 ? (meeting.AttendeeCount * 100) /
                                                    meeting.MaxAttendees : 0;
                                                    var progressClass = percentage >= 90 ? "bg-danger" : percentage >= 70 ?
                                                    "bg-warning" : "bg-success";
                                                }
                                                <div class="progress-bar @progressClass" role="progressbar"
                                                     style="width: @percentage%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = meeting.Status switch
                                            {
                                                "upcoming" => "bg-info",
                                                "ongoing" => "bg-warning",
                                                "completed" => "bg-success",
                                                "cancelled" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@meeting.Status.ToUpper()</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary"
                                                    onclick="viewMeetingDetails('@meeting.Id')">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-success"
                                                    onclick="generateQRCode('@meeting.Id')">
                                                <i class="bi bi-qr-code"></i>
                                            </button>
                                            <a href="api/meetingsapi/meetings/export/@meeting.Id" class="btn btn-outline-secondary">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-info"
                                                    onclick="startMeeting('@meeting.Id')">
                                                <i class="bi bi-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger"
                                                    onclick="deleteMeeting('@meeting.Id')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x me-2"></i>
                                        No meetings found. Create your first meeting!
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Meeting Modal -->
    <div class="modal fade" id="createMeetingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--light-green);">
                    <h5 class="modal-title" style="color: var(--primary-blue);">
                        <i class="bi bi-plus-circle me-2"></i>Create New Meeting
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="createMeetingForm">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label" style="color: var(--primary-blue);">Meeting Name *</label>
                                <input type="text" class="form-control" id="meetingName" required
                                       placeholder="Enter meeting name">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label" style="color: var(--primary-blue);">Description</label>
                                <textarea class="form-control" id="meetingDescription" rows="3"
                                          placeholder="Enter meeting description"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--primary-blue);">Meeting Type *</label>
                                <select class="form-select" id="meetingType" required>
                                    <option value="">Select Type</option>
                                    <option value="physical">Physical (In-person)</option>
                                    <option value="virtual">Virtual (Online)</option>
                                    <option value="hybrid">Hybrid (Both)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--primary-blue);">Max Attendees</label>
                                <input type="number" class="form-control" id="maxAttendees" min="1" max="1000" value="50">
                            </div>
                            <div class="col-md-12" id="venueSection">
                                <label class="form-label" style="color: var(--primary-blue);">Venue/Link *</label>
                                <input type="text" class="form-control" id="meetingVenue"
                                       placeholder="Enter venue address or meeting link">
                                <div class="form-text">For virtual meetings, enter the meeting link (Zoom, Teams, etc.)
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--primary-blue);">Start Date & Time *</label>
                                <input type="datetime-local" class="form-control" id="startDateTime" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--primary-blue);">End Date & Time *</label>
                                <input type="datetime-local" class="form-control" id="endDateTime" required>
                            </div>

                         
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i>Create Meeting
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- QR Code Modal -->
    <div class="modal fade" id="qrCodeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--light-green);">
                    <h5 class="modal-title" style="color: var(--primary-blue);">
                        <i class="bi bi-qr-code me-2"></i>Meeting QR Code
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="qrCodeContainer" class="mb-3"></div>
                    <div class="mb-3">
                        <h5 id="qrMeetingName" class="mb-2"></h5>
                        <p class="text-muted mb-1" id="qrMeetingCode"></p>
                        <p class="text-muted mb-0" id="qrMeetingTime"></p>
                    </div>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="qrCodeUrl" readonly>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyQRCodeUrl()">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" onclick="downloadQRCode()">
                        <i class="bi bi-download me-2"></i>Download QR
                    </button>
                    <button type="button" class="btn btn-primary" onclick="shareQRCode()">
                        <i class="bi bi-share me-2"></i>Share
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Meeting Details Modal -->
    <div class="modal fade" id="meetingDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--light-green);">
                    <h5 class="modal-title" style="color: var(--primary-blue);">
                        <i class="bi bi-info-circle me-2"></i>Meeting Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="meetingDetailsContent">
                        <!-- Content will be loaded here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="generateQRCodeForCurrentMeeting()">
                        <i class="bi bi-qr-code me-2"></i>Generate QR Code
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendees List Modal -->
    <div class="modal fade" id="attendeesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--light-green);">
                    <h5 class="modal-title" style="color: var(--primary-blue);">
                        <i class="bi bi-people me-2"></i>Meeting Attendees
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 id="attendeesMeetingTitle" class="mb-0"></h6>
                            <small class="text-muted" id="attendeesMeetingInfo"></small>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Gender</th>
                                    <th>Check-in Time</th>
                                    <th>Status</th>
                                    
                                </tr>
                            </thead>
                            <tbody id="attendeesListBody">
                                <!-- Attendees will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Styles {
        <style>
                .stats-card {
                    border: 1px solid var(--light-green);
                    border-radius: 12px;
                    transition: transform 0.2s;
                }

                .stats-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
                }

                .stats-icon {
                    width: 60px;
                    height: 60px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 24px;
                }

                .stats-icon.users {
                    background-color: rgba(57, 179, 74, 0.1);
                    color: var(--primary-green);
                }

                .stats-icon.success {
                    background-color: rgba(25, 135, 84, 0.1);
                    color: #198754;
                }

                .stats-icon.warning {
                    background-color: rgba(255, 193, 7, 0.1);
                    color: #ffc107;
                }

                .stats-icon.info {
                    background-color: rgba(13, 202, 240, 0.1);
                    color: #0dcaf0;
                }

                .stats-value {
                    font-size: 32px;
                    font-weight: 700;
                    color: var(--primary-blue);
                    margin-top: 10px;
                }

                .stats-label {
                    color: var(--gray);
                    font-size: 14px;
                    font-weight: 500;
                    text-transform: uppercase;
                }

                .table th {
                    background-color: var(--light-green);
                    color: var(--primary-blue);
                    border-bottom: 2px solid var(--primary-green);
                    font-weight: 600;
                    padding: 12px 16px;
                }

                .table td {
                    padding: 12px 16px;
                    vertical-align: middle;
                }

                .table-hover tbody tr:hover {
                    background-color: rgba(57, 179, 74, 0.05);
                    cursor: pointer;
                }

                .badge {
                    padding: 6px 12px;
                    font-size: 12px;
                    font-weight: 600;
                    border-radius: 20px;
                }

                .btn-group .btn {
                    border-radius: 6px;
                    padding: 4px 8px;
                }

                .progress {
                    background-color: var(--light-gray);
                    border-radius: 4px;
                }

                .progress-bar {
                    border-radius: 4px;
                }

                #qrCodeContainer {
                    padding: 20px;
                    background: white;
                    border-radius: 12px;
                    display: inline-block;
                    border: 2px solid var(--light-green);
                }

                .qr-code {
                    width: 200px;
                    height: 200px;
                }

                .meeting-card {
                    border: 1px solid var(--light-green);
                    border-radius: 12px;
                    padding: 20px;
                    margin-bottom: 20px;
                    transition: all 0.3s;
                }

                .meeting-card:hover {
                    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                    transform: translateY(-2px);
                }

                .meeting-type-icon {
                    width: 50px;
                    height: 50px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 24px;
                    margin-right: 15px;
                }

                .meeting-type-icon.physical {
                    background-color: rgba(13, 110, 253, 0.1);
                    color: #0d6efd;
                }

                .meeting-type-icon.virtual {
                    background-color: rgba(13, 202, 240, 0.1);
                    color: #0dcaf0;
                }

                .meeting-type-icon.hybrid {
                    background-color: rgba(255, 193, 7, 0.1);
                    color: #ffc107;
                }
        </style>
    }

    @section Scripts {
        <!-- QR Code Library -->
        <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
        <!-- HTML2Canvas for QR Code download -->
        <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

        <script>
            let currentMeetingId = null;
            let qrCode = null;

            document.addEventListener('DOMContentLoaded', function () {
            initializePage();
            setupEventListeners();
            updateStats();

            });

            function initializePage() {
            // Set default datetime values
            const now = new Date();
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);

            // Format for datetime-local input
            const formatDateTime = (date) => {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');

            return `${year}-${month}-${day}T${hours}:${minutes}`;
            };

            // Only set values if the modal has been shown at least once
            const startDateTimeInput = document.getElementById('startDateTime');
            const endDateTimeInput = document.getElementById('endDateTime');

            if (startDateTimeInput) {
            startDateTimeInput.value = formatDateTime(tomorrow);
            }

            if (endDateTimeInput) {
            const endTime = new Date(tomorrow.getTime() + 2 * 60 * 60 * 1000); // +2 hours
            endDateTimeInput.value = formatDateTime(endTime);
            }

            // Initialize modals properly
            const createMeetingModal = document.getElementById('createMeetingModal');
            if (createMeetingModal) {
            createMeetingModal.addEventListener('show.bs.modal', function () {
            // Reset form when modal opens
            const form = document.getElementById('createMeetingForm');
            if (form) {
            form.reset();
            // Set default values
            const startInput = document.getElementById('startDateTime');
            const endInput = document.getElementById('endDateTime');
            if (startInput && !startInput.value) {
            startInput.value = formatDateTime(tomorrow);
            }
            if (endInput && !endInput.value) {
            const endTime = new Date(tomorrow.getTime() + 2 * 60 * 60 * 1000);
            endInput.value = formatDateTime(endTime);
            }
            }
            });
            }
            }
            // Replace the problematic createMeeting function with this corrected version:

            async function createMeeting(e) {
            e.preventDefault();

            try {
            // Get form values from the modal
            const meetingName = document.getElementById('meetingName').value;
            const meetingDescription = document.getElementById('meetingDescription').value;
            const meetingType = document.getElementById('meetingType').value;
            const meetingVenue = document.getElementById('meetingVenue').value;
            const maxAttendees = parseInt(document.getElementById('maxAttendees').value) || 50;
            const startDateTime = document.getElementById('startDateTime').value;
            const endDateTime = document.getElementById('endDateTime').value;

            // Validate required fields
            if (!meetingName || !meetingType || !meetingVenue || !startDateTime || !endDateTime) {
            showToast('Please fill in all required fields', 'danger');
            return;
            }

            // Validate date range
            const startDate = new Date(startDateTime);
            const endDate = new Date(endDateTime);
            if (endDate <= startDate) {
            showToast('End time must be after start time', 'danger');
            return;
            }

            // Show loading state
            const submitBtn = document.querySelector('#createMeetingForm button[type="submit"]');
            const originalText = submitBtn.innerHTML; // Store original text
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Creating...';
            submitBtn.disabled = true;

            // Generate meeting code
            const meetingCode = generateMeetingCode();

            // Prepare meeting data
            const meetingData = {
            name: meetingName,
            description: meetingDescription,
            type: meetingType,
            venue: meetingVenue,
            maxAttendees: maxAttendees,
            startTime: startDateTime,
            endTime: endDateTime,
            meetingCode: meetingCode
            };
            console.log(JSON.stringify(meetingData))
            // Send to API
            const response = await fetch('/api/meetingsapi/meetings', {
            method: 'POST',
            headers: {
            'Content-Type': 'application/json',
            @* 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value *@
            },
            body: JSON.stringify(meetingData)
            });

