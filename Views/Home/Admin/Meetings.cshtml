            function concludeMeeting(meetingId) {
                if (confirm('Are you sure you want to conclude this event? Attendees wont be able to check in.')) {
                    fetch(`/api/meetingsApi/${meetingId}/conclude-meeting`, {
                        method: 'PUT',
                        headers: {
                        'Content-Type': 'application/json'
                        }
                    })
                    .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to update meeting');
                    }
                    return response.json();
                    })
                    .then(data => {
                        showToast('Meeting concluded successfully', 'success');
                        // Optional: redirect or refresh
