@model ayuteng.Models.Meeting
@{
    ViewData["Title"] = "Meeting Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ayute</title>
    <style>
        :root {
            --primary-green: #39B34A;
            --primary-yellow: #DEE33B;
            --primary-blue: #073150;
            --light-green: #E9F7EC;
            --light-yellow: #FDFDE8;
            --light-blue: #F0F7FB;
            --white: #FFFFFF;
            --gray: #5D6D7E;
            --light-gray: #F5F5F5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, #0c4168 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .registration-container {
            width: 100%;
            max-width: 500px;
        }

        .registration-card {
            background: var(--white);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            border: 1px solid var(--light-green);
        }

        .meeting-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--light-green);
        }

        .meeting-header h1 {
            color: var(--primary-blue);
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .meeting-code {
            background-color: var(--light-blue);
            color: var(--primary-blue);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 15px;
        }

        .meeting-details {
            margin-bottom: 30px;
        }

        .detail-item {
            display: flex;
            margin-bottom: 10px;
        }

        .detail-label {
            width: 100px;
            color: var(--gray);
            font-size: 14px;
            font-weight: 500;
        }

        .detail-value {
            flex: 1;
            color: var(--primary-blue);
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 6px;
            color: var(--primary-blue);
            font-size: 14px;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--light-green);
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: var(--light-gray);
            color: var(--primary-blue);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-green);
            background: var(--light-green);
            box-shadow: 0 0 0 3px rgba(57, 179, 74, 0.1);
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary-green) 0%, #2e8b3e 100%);
            color: var(--white);
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            letter-spacing: 0.5px;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(57, 179, 74, 0.3);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit.loading {
            position: relative;
            color: transparent;
        }

        .btn-submit.loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: var(--white);
            animation: spin 1s linear infinite;
        }

        .message {
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: left;
            display: none;
        }

        .message.success {
            background-color: var(--light-green);
            color: #0f5132;
            border-left: 4px solid var(--primary-green);
        }

        .message.error {
            background-color: #f8d7da;
            color: #842029;
            border-left: 4px solid #dc3545;
        }

        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 12px;
        }

        @@keyframes spin {
            to {
                transform: translate(-50%, -50%) rotate(360deg);
            }
        }

        @@media (max-width: 480px) {
            .registration-card {
                padding: 30px 20px;
            }

            body {
                padding: 10px;
            }
        }
    </style>
</head>

<body>
    <div class="registration-container">
        <div class="registration-card">
            <div class="meeting-header">
                <h1>@Model.Name</h1>
                <div class="meeting-code">@Model.MeetingCode</div>
            </div>

            <div class="meeting-details">
                <div class="detail-item">
                    <div class="detail-label">Date:</div>
                    <div class="detail-value">@Model.StartTime.ToString("dddd, MMMM dd, yyyy")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Time:</div>
                    <div class="detail-value">@Model.StartTime.ToString("hh:mm tt") - @Model.EndTime.ToString("hh:mm                       tt")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Type:</div>
                    <div class="detail-value">
                        @if (Model.Type == "virtual")
                        {
                            <span>Virtual Meeting</span>
                        }
                        else if (Model.Type == "physical")
                        {
                            <span>Physical Meeting</span>
                        }
                        else
                        {
                            <span>Hybrid Meeting</span>
                        }
                    </div>
                </div>
                @if (Model.Type == "virtual" || Model.Type == "hybrid")
                {
                    <div class="detail-item">
                        <div class="detail-label">Link:</div>
                        <div class="detail-value">
                            <a href="@Model.Venue" target="_blank" style="color: var(--primary-green);">Join Meeting</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="detail-item">
                        <div class="detail-label">Venue:</div>
                        <div class="detail-value">@Model.Venue</div>
                    </div>
                }
            </div>

            <div id="message" class="message"></div>

            <form id="registrationForm" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label" for="Name">Full Name *</label>
                    <input type="text" id="Name" name="Name" class="form-control" placeholder="Enter your full name"
                        required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="Email">Email Address</label>
                    <input type="email" id="Email" name="Email" class="form-control"
                        placeholder="Enter your email address">
                </div>
                <input type="hidden" name="Location" id="location" />
                <div class="form-group">
                    <label class="form-label" for="Phone">Phone Number</label>
                    <input type="tel" id="Phone" name="Phone" class="form-control"
                        placeholder="Enter your phone number">
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    Register for Meeting
                </button>
            </form>
        </div>

        <div class="copyright">
            © @DateTime.Now.Year Ayute. All rights reserved.
        </div>
    </div>
    <script>
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                async function (position) {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    console.log(lat, lon)
                    try {
                        const response = await fetch(
                            `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`
                        );
                        const data = await response.json();

                        // Full readable address
                        const address = data.display_name;

                        // Or pick specific parts
                        // const address = `${data.address.city || data.address.town || data.address.village}, ${data.address.state}, ${data.address.country}`;

                        document.getElementById("location").value = address;
                    } catch (err) {
                        console.error("Failed to get location name", err);
                    }
                },
                function () {
                    console.warn("Location access denied");
                }
            );
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('registrationForm');
            const submitBtn = document.getElementById('submitBtn');
            const messageDiv = document.getElementById('message');

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const name = document.getElementById('Name').value.trim();

                if (!name) {
                    showMessage('Please enter your full name', 'error');
                    return;
                }

                // Show loading state
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;

                try {
                    // Submit form data
                    const formData = new FormData(this);

                    const response = await fetch(this.action, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        // Redirect to success page
                        window.location.href = response.url;
                    } else {
                        const errorText = await response.text();
                        showMessage('Registration failed. Please try again.', 'error');
                    }

                } catch (error) {
                    console.error('Error:', error);
                    showMessage('Registration failed. Please try again.', 'error');
                } finally {
                    submitBtn.classList.remove('loading');
                    submitBtn.disabled = false;
                }
            });

            function showMessage(text, type) {
                messageDiv.textContent = text;
                messageDiv.className = `message ${type}`;
                messageDiv.style.display = 'block';
            }

            // Focus name field on load
            document.getElementById('Name').focus();
        });
    </script>
</body>

</html>